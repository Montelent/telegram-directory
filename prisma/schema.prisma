generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EntityType {
  GROUP
  CHANNEL
}

enum EntityStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entities    Entity[]

  @@map("categories")
}

model Entity {
  id            String       @id @default(cuid())
  username      String?
  title         String
  description   String?
  type          EntityType
  status        EntityStatus @default(PENDING)
  memberCount   Int?
  language      String?
  country       String?
  inviteLink    String?
  photoUrl      String?
  isVerified    Boolean      @default(false)
  isScam        Boolean      @default(false)
  lastCheckedAt DateTime?
  source        String?
  externalId    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id])

  submissions   Submission[]
  reviews       Review[]

  @@unique([username])
  @@index([status])
  @@index([type])
  @@index([categoryId])
  @@map("entities")
}

model Submission {
  id          String       @id @default(cuid())
  username    String
  title       String?
  description String?
  type        EntityType
  status      EntityStatus @default(PENDING)
  submittedBy String?
  userId      String?
  user        User?        @relation(fields: [userId], references: [id])
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  entityId    String?
  entity      Entity?      @relation(fields: [entityId], references: [id])

  @@map("submissions")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews     Review[]
  submissions Submission[]

  @@map("users")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([userId, entityId])
  @@index([entityId])
  @@map("reviews")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

model ApiIntegration {
  id          String   @id @default(cuid())
  name        String
  key         String
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("api_integrations")
}
